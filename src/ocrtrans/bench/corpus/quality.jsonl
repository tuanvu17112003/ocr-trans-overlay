{"id": "dlg1", "category": "dialogue", "text": "Open the gate, traveler.", "ref_vi": "Mở cổng đi, lữ khách."}
{"id": "dlg2", "category": "dialogue", "text": "We must leave before dawn.", "ref_vi": "Chúng ta phải rời đi trước bình minh."}
{"id": "dlg3", "category": "dialogue", "text": "You are not welcome here.", "ref_vi": "Ngươi không được chào đón ở đây."}
{"id": "dlg4", "category": "dialogue", "text": "The king will see you now.", "ref_vi": "Nhà vua sẽ gặp ngươi ngay bây giờ."}
{"id": "dlg5", "category": "dialogue", "text": "I have waited a long time.", "ref_vi": "Ta đã đợi rất lâu rồi."}
{"id": "dlg6", "category": "dialogue", "text": "Do not trust the merchant.", "ref_vi": "Đừng tin tên thương nhân."}
{"id": "dlg7", "category": "dialogue", "text": "Take this and go.", "ref_vi": "Cầm lấy thứ này và đi đi."}
{"id": "dlg8", "category": "dialogue", "text": "We will meet again.", "ref_vi": "Chúng ta sẽ gặp lại."}
{"id": "qst1", "category": "quest", "text": "Find the lost sword in the cave.", "ref_vi": "Tìm thanh kiếm thất lạc trong hang động."}
{"id": "qst2", "category": "quest", "text": "Speak to the village elder.", "ref_vi": "Nói chuyện với trưởng làng."}
{"id": "qst3", "category": "quest", "text": "Collect 5 herbs from the forest.", "ref_vi": "Thu thập 5 loại thảo mộc trong rừng."}
{"id": "qst4", "category": "quest", "text": "Return to the captain.", "ref_vi": "Quay lại chỗ đội trưởng."}
{"id": "qst5", "category": "quest", "text": "Defeat the bandit leader.", "ref_vi": "Đánh bại thủ lĩnh bọn cướp."}
{"id": "qst6", "category": "quest", "text": "Escort the caravan safely.", "ref_vi": "Hộ tống đoàn xe an toàn."}
{"id": "qst7", "category": "quest", "text": "Search the ruins for clues.", "ref_vi": "Tìm manh mối trong khu tàn tích."}
{"id": "qst8", "category": "quest", "text": "Repair the bridge before sunset.", "ref_vi": "Sửa cây cầu trước khi mặt trời lặn."}
{"id": "itm1", "category": "item", "text": "Health Potion restores 50 HP.", "ref_vi": "Thuốc hồi máu hồi phục 50 HP."}
{"id": "itm2", "category": "item", "text": "Iron Sword deals 12 damage.", "ref_vi": "Kiếm sắt gây 12 sát thương."}
{"id": "itm3", "category": "item", "text": "Ancient Key opens the vault.", "ref_vi": "Chìa khóa cổ mở kho bạc."}
{"id": "itm4", "category": "item", "text": "Silver Ring grants +5 defense.", "ref_vi": "Nhẫn bạc tăng +5 phòng thủ."}
{"id": "itm5", "category": "item", "text": "Rope can be used to climb.", "ref_vi": "Dây thừng có thể dùng để leo."}
{"id": "itm6", "category": "item", "text": "Torch burns for 10 minutes.", "ref_vi": "Đuốc cháy trong 10 phút."}
{"id": "itm7", "category": "item", "text": "Map of the Northern Realm.", "ref_vi": "Bản đồ vùng Bắc Giới."}
{"id": "itm8", "category": "item", "text": "Elixir of Speed lasts 30 seconds.", "ref_vi": "Thuốc tăng tốc kéo dài 30 giây."}
{"id": "skl1", "category": "skill", "text": "Fireball explodes on impact.", "ref_vi": "Cầu lửa phát nổ khi va chạm."}
{"id": "skl2", "category": "skill", "text": "Heal restores health over time.", "ref_vi": "Hồi máu phục hồi máu theo thời gian."}
{"id": "skl3", "category": "skill", "text": "Dash moves you forward quickly.", "ref_vi": "Lướt đi đưa bạn tiến lên nhanh chóng."}
{"id": "skl4", "category": "skill", "text": "Shield blocks the next attack.", "ref_vi": "Khiên chặn đòn tấn công tiếp theo."}
{"id": "skl5", "category": "skill", "text": "Frost slows enemies.", "ref_vi": "Băng giá làm chậm kẻ địch."}
{"id": "skl6", "category": "skill", "text": "Arrow Rain hits all targets.", "ref_vi": "Mưa Tên đánh trúng mọi mục tiêu."}
{"id": "skl7", "category": "skill", "text": "Shadow Step teleports behind.", "ref_vi": "Bước Bóng dịch chuyển ra phía sau."}
{"id": "skl8", "category": "skill", "text": "Rally boosts ally damage.", "ref_vi": "Cổ Vũ tăng sát thương đồng minh."}
{"id": "cmb1", "category": "combat_log", "text": "You hit the wolf for 8 damage.", "ref_vi": "Bạn đánh sói 8 sát thương."}
{"id": "cmb2", "category": "combat_log", "text": "The wolf misses you.", "ref_vi": "Sói đánh trượt bạn."}
{"id": "cmb3", "category": "combat_log", "text": "Critical hit! 24 damage.", "ref_vi": "Chí mạng! 24 sát thương."}
{"id": "cmb4", "category": "combat_log", "text": "You are poisoned.", "ref_vi": "Bạn đã bị trúng độc."}
{"id": "cmb5", "category": "combat_log", "text": "The enemy is stunned.", "ref_vi": "Kẻ địch đã bị choáng."}
{"id": "cmb6", "category": "combat_log", "text": "You gained 15 experience.", "ref_vi": "Bạn nhận được 15 kinh nghiệm."}
{"id": "cmb7", "category": "combat_log", "text": "Your shield broke.", "ref_vi": "Khiên của bạn đã vỡ."}
{"id": "cmb8", "category": "combat_log", "text": "The goblin flees.", "ref_vi": "Yêu tinh bỏ chạy."}
