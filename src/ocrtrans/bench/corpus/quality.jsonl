{"id": "tip1", "category": "tooltip", "text": "Hold to charge the attack.", "ref_vi": "Giữ để nạp đòn tấn công."}
{"id": "tip2", "category": "tooltip", "text": "Requires level 10.", "ref_vi": "Yêu cầu cấp 10."}
{"id": "tip3", "category": "tooltip", "text": "Cannot be used in combat.", "ref_vi": "Không thể dùng khi giao chiến."}
{"id": "tip4", "category": "tooltip", "text": "Right click to equip.", "ref_vi": "Nhấp chuột phải để trang bị."}
{"id": "tip5", "category": "tooltip", "text": "Increases movement speed.", "ref_vi": "Tăng tốc độ di chuyển."}
{"id": "tip6", "category": "tooltip", "text": "Only works at night.", "ref_vi": "Chỉ hoạt động vào ban đêm."}
{"id": "tip7", "category": "tooltip", "text": "Consumes one charge.", "ref_vi": "Tiêu hao một lần nạp."}
{"id": "tip8", "category": "tooltip", "text": "Talk to the blacksmith.", "ref_vi": "Nói chuyện với thợ rèn."}
{"id": "lor1", "category": "lore", "text": "Long ago the dragons ruled the sky.", "ref_vi": "Từ lâu lắm rồi, loài rồng thống trị bầu trời."}
{"id": "lor2", "category": "lore", "text": "The empire fell in a single night.", "ref_vi": "Đế chế sụp đổ trong một đêm."}
{"id": "lor3", "category": "lore", "text": "Four stones guard the ancient seal.", "ref_vi": "Bốn viên đá canh giữ phong ấn cổ."}
{"id": "lor4", "category": "lore", "text": "The river remembers every name.", "ref_vi": "Dòng sông nhớ mọi cái tên."}
{"id": "lor5", "category": "lore", "text": "No one returns from the Deep.", "ref_vi": "Không ai trở về từ Vực Sâu."}
{"id": "lor6", "category": "lore", "text": "The prophet spoke of a child.", "ref_vi": "Nhà tiên tri đã nói về một đứa trẻ."}
{"id": "lor7", "category": "lore", "text": "Steel was forged in dragon fire.", "ref_vi": "Thép được rèn trong lửa rồng."}
{"id": "lor8", "category": "lore", "text": "The old gods sleep beneath the mountain.", "ref_vi": "Các vị thần cũ ngủ dưới ngọn núi."}
{"id": "num1", "category": "numbers", "text": "You have 3 HP left.", "ref_vi": "Bạn còn 3 HP."}
{"id": "num2", "category": "numbers", "text": "Deal 250 damage in 10 seconds.", "ref_vi": "Gây 250 sát thương trong 10 giây."}
{"id": "num3", "category": "numbers", "text": "Cost: 120 gold.", "ref_vi": "Giá: 120 vàng."}
{"id": "num4", "category": "numbers", "text": "Level 42 required.", "ref_vi": "Yêu cầu cấp 42."}
{"id": "num5", "category": "numbers", "text": "Survive for 90 seconds.", "ref_vi": "Sống sót trong 90 giây."}
{"id": "num6", "category": "numbers", "text": "Gain 2.5% critical chance.", "ref_vi": "Tăng 2.5% tỉ lệ chí mạng."}
{"id": "num7", "category": "numbers", "text": "Party of 4 players.", "ref_vi": "Nhóm 4 người chơi."}
{"id": "num8", "category": "numbers", "text": "Cooldown: 12 seconds.", "ref_vi": "Hồi chiêu: 12 giây."}
{"id": "pn1", "category": "proper_nouns", "text": "Arthur draws the sword.", "ref_vi": "Arthur rút thanh kiếm."}
{"id": "pn2", "category": "proper_nouns", "text": "Merlin waits by the lake.", "ref_vi": "Merlin đợi bên hồ."}
{"id": "pn3", "category": "proper_nouns", "text": "The city of Aldoria is burning.", "ref_vi": "Thành phố Aldoria đang cháy."}
{"id": "pn4", "category": "proper_nouns", "text": "Queen Elara sends her regards.", "ref_vi": "Nữ hoàng Elara gửi lời hỏi thăm."}
{"id": "pn5", "category": "proper_nouns", "text": "Travel to Mount Varn.", "ref_vi": "Đi đến Núi Varn."}
{"id": "pn6", "category": "proper_nouns", "text": "The Order of Dawn is here.", "ref_vi": "Hội Bình Minh đã đến."}
{"id": "pn7", "category": "proper_nouns", "text": "Lord Draven holds the keep.", "ref_vi": "Lãnh chúa Draven giữ thành."}
{"id": "pn8", "category": "proper_nouns", "text": "Follow the road to Silvermere.", "ref_vi": "Đi theo con đường đến Silvermere."}
